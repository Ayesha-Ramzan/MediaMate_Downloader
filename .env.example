# Backend Environment Variables Example
# Copy this to .env and fill in your values

# Server Configuration
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# Storage
BASE_DIR=/mnt/data/mediamate

# CORS - Comma-separated list of allowed frontend URLs
# Example: https://mediamate-downloader.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Optional: If deploying to Hugging Face Spaces
# HF_SPACES_REPO_ID=your-username/repo-name
